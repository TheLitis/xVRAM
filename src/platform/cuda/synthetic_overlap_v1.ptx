// xVRAM synthetic overlap module v1.
// The dependent integer chain is compute-bound; only the final value is written.
.version 6.0
.target sm_50
.address_size 64

.visible .entry xvram_overlap_spin_v1(
    .param .u64 output,
    .param .u32 iterations
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<9>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [output];
    ld.param.u32 %r1, [iterations];
    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r5, %r3, %r4, %r2;
    xor.b32 %r6, %r5, 0x9e3779b9;
    mov.u32 %r7, 0;

xvram_overlap_loop:
    mad.lo.u32 %r6, %r6, 1664525, 1013904223;
    xor.b32 %r6, %r6, %r5;
    add.u32 %r7, %r7, 1;
    setp.lt.u32 %p1, %r7, %r1;
    @%p1 bra xvram_overlap_loop;

    mul.wide.u32 %rd2, %r5, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r6;
    ret;
}
