        "unsafe_remap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_transition_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_hits": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_misses": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_hit_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "clean_evictions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "dirty_evictions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "writebacks_completed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_shrink_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_grow_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_oom_retry_count": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "total_ms", "minimum_ms", "median_ms", "p95_ms", "maximum_ms"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "total_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "minimum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "median_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "p95_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "maximum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" }
      },
      "allOf": [{
        "if": { "properties": { "sample_count": { "minimum": 1 } }, "required": ["sample_count"] },
        "then": {
          "properties": {
            "total_ms": { "type": "number", "minimum": 0 },
            "minimum_ms": { "type": "number", "minimum": 0 },
            "median_ms": { "type": "number", "minimum": 0 },
            "p95_ms": { "type": "number", "minimum": 0 },
            "maximum_ms": { "type": "number", "minimum": 0 }
          }
        }
      }]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cuda_driver_version", "cublas_version", "cublas_lt_version", "cublas_lt_available",
        "cublas_library_source", "algorithms_selected", "algorithm_cache_hits",
        "budget_sample_count", "cuda_free_bytes_minimum", "cuda_free_bytes_end",
        "wddm_available_bytes_minimum", "wddm_available_bytes_end", "replans",
        "watchdog_rejections", "total_elapsed_ms", "plan_timing", "tile_timing",
        "gemm_timing", "h2d_timing", "d2h_timing", "writeback_timing"
      ],
      "properties": {
        "cuda_driver_version": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cublas_version": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cublas_lt_version": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cublas_lt_available": { "$ref": "#/$defs/nullableBoolean" },
        "cublas_library_source": {
          "type": ["string", "null"],
          "enum": ["system", "app_local", "explicit", null]
        },
        "algorithms_selected": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "algorithm_cache_hits": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "budget_sample_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cuda_free_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cuda_free_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "replans": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "watchdog_rejections": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "total_elapsed_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "plan_timing": { "$ref": "#/$defs/timing" },
        "tile_timing": { "$ref": "#/$defs/timing" },
        "gemm_timing": { "$ref": "#/$defs/timing" },
        "h2d_timing": { "$ref": "#/$defs/timing" },
        "d2h_timing": { "$ref": "#/$defs/timing" },
        "writeback_timing": { "$ref": "#/$defs/timing" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_allocation_bytes", "total_vram_bytes", "maximum_cache_target_bytes",
        "maximum_working_set_bytes", "workspace_cap_bytes", "logical_data_exceeds_vram",
        "cache_smaller_than_logical", "tiled_execution_verified", "handles_reused",
        "stable_virtual_addresses_verified", "set_access_after_map_verified",
        "event_boundaries_verified", "no_physical_aliases_verified",
        "dirty_writeback_verified", "cache_target_respected", "workspace_bounded",
        "all_workloads_match_reference", "raw_virtual_addresses_omitted"
      ],
      "properties": {
        "logical_allocation_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "total_vram_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "maximum_cache_target_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "maximum_working_set_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "workspace_cap_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_data_exceeds_vram": { "$ref": "#/$defs/nullableBoolean" },
        "cache_smaller_than_logical": { "$ref": "#/$defs/nullableBoolean" },
        "tiled_execution_verified": { "$ref": "#/$defs/nullableBoolean" },
        "handles_reused": { "$ref": "#/$defs/nullableBoolean" },
        "stable_virtual_addresses_verified": { "$ref": "#/$defs/nullableBoolean" },
        "set_access_after_map_verified": { "$ref": "#/$defs/nullableBoolean" },
        "event_boundaries_verified": { "$ref": "#/$defs/nullableBoolean" },
        "no_physical_aliases_verified": { "$ref": "#/$defs/nullableBoolean" },
        "dirty_writeback_verified": { "$ref": "#/$defs/nullableBoolean" },
        "cache_target_respected": { "$ref": "#/$defs/nullableBoolean" },
        "workspace_bounded": { "$ref": "#/$defs/nullableBoolean" },
        "all_workloads_match_reference": { "$ref": "#/$defs/nullableBoolean" },
        "raw_virtual_addresses_omitted": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "exit_code", "stage", "operation", "native_code",
        "native_name", "message", "plan_id", "tile_sequence", "logical_byte_offset"
      ],
      "properties": {
        "status": { "enum": ["completed", "skipped", "failed", "timed_out"] },
        "reason": { "$ref": "#/$defs/nullableString" },
        "exit_code": { "enum": [0, 23, 24, 25, 26, 27, 64, 70, 74] },
        "stage": { "$ref": "#/$defs/nullableString" },
        "operation": { "$ref": "#/$defs/nullableString" },
        "native_code": { "$ref": "#/$defs/nullableInteger" },
        "native_name": { "$ref": "#/$defs/nullableString" },
        "message": { "$ref": "#/$defs/nullableString" },
        "plan_id": { "$ref": "#/$defs/nullablePositiveInteger" },
        "tile_sequence": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      },
      "allOf": [{
        "if": {
          "properties": { "status": { "enum": ["skipped", "failed", "timed_out"] } },
          "required": ["status"]
        },
        "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
      }]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete", "operations_drained", "events_drained", "events_destroyed",
        "streams_destroyed", "cublas_handles_destroyed", "mappings_removed",
        "physical_handles_released", "workspace_released", "virtual_reservations_released",
        "pinned_staging_released", "host_backing_released", "context_released",
        "worker_terminated"
      ],
      "properties": {
        "complete": { "$ref": "#/$defs/nullableBoolean" },
        "operations_drained": { "$ref": "#/$defs/nullableBoolean" },
        "events_drained": { "$ref": "#/$defs/nullableBoolean" },
        "events_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "streams_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "cublas_handles_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "mappings_removed": { "$ref": "#/$defs/nullableBoolean" },
        "physical_handles_released": { "$ref": "#/$defs/nullableBoolean" },
        "workspace_released": { "$ref": "#/$defs/nullableBoolean" },
        "virtual_reservations_released": { "$ref": "#/$defs/nullableBoolean" },
        "pinned_staging_released": { "$ref": "#/$defs/nullableBoolean" },
        "host_backing_released": { "$ref": "#/$defs/nullableBoolean" },
        "context_released": { "$ref": "#/$defs/nullableBoolean" },
        "worker_terminated": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "component", "operation", "message", "code", "device_ordinal"],
      "properties": {
        "level": { "enum": ["info", "warning", "error"] },
        "component": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/nullableInteger" },
        "device_ordinal": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
