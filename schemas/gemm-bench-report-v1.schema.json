{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheLitis/xVRAM/main/schemas/gemm-bench-report-v1.schema.json",
  "title": "xVRAM tiled GEMM benchmark report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "generated_at_utc", "build", "system", "device",
    "configuration", "plans", "workloads", "numerics", "cache", "telemetry", "proof",
    "outcome", "cleanup", "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_type": { "const": "xvram.gemm_bench" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "build": { "$ref": "#/$defs/build" },
    "system": { "$ref": "#/$defs/system" },
    "device": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/device" }] },
    "configuration": { "$ref": "#/$defs/configuration" },
    "plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } },
    "workloads": { "type": "array", "items": { "$ref": "#/$defs/workload" } },
    "numerics": { "$ref": "#/$defs/numerics" },
    "cache": { "$ref": "#/$defs/cache" },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "proof": { "$ref": "#/$defs/proof" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "allOf": [{
    "if": {
      "properties": { "outcome": { "properties": { "status": { "const": "completed" } } } },
      "required": ["outcome"]
    },
    "then": {
      "properties": {
        "device": { "$ref": "#/$defs/device" },
        "plans": {
          "minItems": 1,
          "items": { "properties": { "status": { "const": "completed" } } }
        },
        "workloads": {
          "minItems": 1,
          "items": { "properties": { "status": { "const": "completed" } } }
        },
        "numerics": {
          "properties": {
            "validation_mode": { "enum": ["cpu", "structured"] },
            "reference_precision": { "enum": ["fp32", "fp64", "analytic"] },
            "elements_verified": { "type": "integer", "minimum": 1 },
            "mismatch_count": { "const": 0 },
            "first_mismatch_byte_offset": { "const": null },
            "expected_digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "output_digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "all_results_match": { "const": true }
          }
        },
        "cache": {
          "properties": {
            "target_bytes_initial": { "type": "integer", "minimum": 1 },
            "target_bytes_minimum": { "type": "integer", "minimum": 1 },
            "target_bytes_maximum": { "type": "integer", "minimum": 1 },
            "target_bytes_end": { "type": "integer", "minimum": 1 },
            "resident_bytes_peak": { "type": "integer", "minimum": 1 },
            "pinned_staging_bytes": { "type": "integer", "minimum": 1 },
            "workspace_bytes_peak": { "type": "integer", "minimum": 0 },
            "physical_frame_count_peak": { "type": "integer", "minimum": 1 },
            "physical_handle_create_count": { "type": "integer", "minimum": 1 },
            "physical_handle_release_count": { "type": "integer", "minimum": 1 },
            "mapping_count": { "type": "integer", "minimum": 1 },
            "unmap_count": { "type": "integer", "minimum": 1 },
            "set_access_count": { "type": "integer", "minimum": 1 },
            "event_boundary_count": { "type": "integer", "minimum": 1 },
            "unsafe_remap_count": { "const": 0 },
            "unsafe_transition_count": { "const": 0 }
          }
        },
        "proof": {
          "properties": {
            "logical_allocation_bytes": { "type": "integer", "minimum": 1 },
            "total_vram_bytes": { "type": "integer", "minimum": 1 },
            "maximum_cache_target_bytes": { "type": "integer", "minimum": 1 },
            "maximum_working_set_bytes": { "type": "integer", "minimum": 1 },
            "workspace_cap_bytes": { "type": "integer", "minimum": 0 },
            "logical_data_exceeds_vram": { "type": "boolean" },
            "cache_smaller_than_logical": { "type": "boolean" },
            "tiled_execution_verified": { "const": true },
            "handles_reused": { "type": "boolean" },
            "stable_virtual_addresses_verified": { "const": true },
            "set_access_after_map_verified": { "const": true },
            "event_boundaries_verified": { "const": true },
            "no_physical_aliases_verified": { "const": true },
            "dirty_writeback_verified": { "const": true },
            "cache_target_respected": { "const": true },
            "workspace_bounded": { "const": true },
            "all_workloads_match_reference": { "const": true },
            "raw_virtual_addresses_omitted": { "const": true }
          }
        },
        "outcome": {
          "properties": {
            "reason": { "const": null },
            "exit_code": { "const": 0 }
          }
        },
        "cleanup": {
          "properties": {
            "complete": { "const": true },
            "operations_drained": { "const": true },
            "events_drained": { "const": true },
            "events_destroyed": { "const": true },
            "streams_destroyed": { "const": true },
            "cublas_handles_destroyed": { "const": true },
            "mappings_removed": { "const": true },
            "physical_handles_released": { "const": true },
            "workspace_released": { "const": true },
            "virtual_reservations_released": { "const": true },
            "pinned_staging_released": { "const": true },
            "host_backing_released": { "const": true },
            "context_released": { "const": true },
            "worker_terminated": { "const": true }
          }
        }
      }
    }
  }, {
    "if": {
      "properties": { "outcome": { "properties": { "status": { "const": "skipped" } } } },
      "required": ["outcome"]
    },
    "then": {
      "properties": { "outcome": { "properties": { "exit_code": { "const": 23 } } } }
    }
  }, {
    "if": {
      "properties": { "outcome": { "properties": { "status": { "const": "timed_out" } } } },
      "required": ["outcome"]
    },
    "then": {
      "properties": { "outcome": { "properties": { "exit_code": { "const": 26 } } } }
    }
  }, {
    "if": {
      "properties": { "outcome": { "properties": { "status": { "const": "failed" } } } },
      "required": ["outcome"]
    },
    "then": {
      "properties": {
        "outcome": { "properties": { "exit_code": { "enum": [24, 25, 27, 64, 70, 74] } } }
      }
    }
  }, {
    "if": {
      "properties": {
        "configuration": {
          "properties": { "identifiers_included": { "const": false } },
          "required": ["identifiers_included"]
        }
      },
      "required": ["configuration"]
    },
    "then": {
      "properties": {
        "device": {
          "oneOf": [{
            "type": "null"
          }, {
            "allOf": [{ "$ref": "#/$defs/device" }, {
              "properties": {
                "uuid": { "const": null },
                "luid": { "const": null },
                "pci_bus_id": { "const": null }
              }
            }]
          }]
        }
      }
    }
  }, {
    "properties": {
      "cleanup": { "properties": { "worker_terminated": { "const": true } } }
    }
  }],
  "$defs": {
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "nullableNonNegativeNumber": { "type": ["number", "null"], "minimum": 0 },
    "nullableString": { "type": ["string", "null"] },
    "nullableBoolean": { "type": ["boolean", "null"] },
    "nullableDigest128": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "dataType": { "enum": ["fp16", "bf16", "fp32", "fp64"] },
    "computeMode": { "enum": ["auto", "fp32_strict", "tf32", "fp64"] },
    "layout": { "enum": ["row_major", "column_major"] },
    "matrixOperation": { "enum": ["n", "t"] },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit", "compiler", "build_type", "cuda_headers_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "build_type": { "type": "string", "minLength": 1 },
        "cuda_headers_version": { "type": "integer", "minimum": 13000 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name", "os_version", "architecture", "logical_processor_count",
        "physical_memory_bytes", "available_memory_bytes"
      ],
      "properties": {
        "os_name": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string" },
        "architecture": { "type": "string", "minLength": 1 },
        "logical_processor_count": { "type": "integer", "minimum": 0 },
        "physical_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "available_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "name", "uuid", "luid", "pci_bus_id", "driver_model",
        "total_memory_bytes", "free_memory_bytes_start", "free_memory_bytes_end",
        "safe_device_budget_bytes", "wddm_budget_bytes_start", "wddm_usage_bytes_start",
        "wddm_available_bytes_start", "wddm_available_bytes_minimum",
        "wddm_available_bytes_end", "vmm_supported", "uva_supported",
        "minimum_granularity_bytes", "recommended_granularity_bytes",
        "compute_capability_major", "compute_capability_minor"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "uuid": { "$ref": "#/$defs/nullableString" },
        "luid": { "$ref": "#/$defs/nullableString" },
        "pci_bus_id": { "$ref": "#/$defs/nullableString" },
        "driver_model": {
          "type": ["string", "null"],
          "enum": ["wddm", "tcc", "mcdm", "unknown", null]
        },
        "total_memory_bytes": { "type": "integer", "minimum": 1 },
        "free_memory_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "free_memory_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "safe_device_budget_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_budget_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_usage_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "vmm_supported": { "type": "boolean" },
        "uva_supported": { "type": "boolean" },
        "minimum_granularity_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "recommended_granularity_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "compute_capability_major": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compute_capability_minor": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_device_ordinal", "requested_m", "requested_n", "requested_k", "scenario",
        "a_data_type", "b_data_type", "c_data_type", "compute_mode", "a_layout", "b_layout",
        "c_layout", "a_operation", "b_operation", "alpha", "beta", "requested_chunk_bytes",
        "effective_chunk_bytes", "requested_cache_target_bytes", "initial_cache_target_bytes",
        "requested_workspace_cap_bytes", "effective_workspace_cap_bytes", "context_mode",
        "policy", "staging_slots", "prefetch_distance", "passes", "budget_poll_ms",
        "stall_timeout_ms", "timeout_ms", "max_tile_ms", "identifiers_included"
      ],
      "properties": {
        "requested_device_ordinal": { "type": ["integer", "null"], "minimum": 0 },
        "requested_m": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_n": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_k": { "$ref": "#/$defs/nullablePositiveInteger" },
        "scenario": { "type": "string", "minLength": 1 },
        "a_data_type": { "$ref": "#/$defs/dataType" },
        "b_data_type": { "$ref": "#/$defs/dataType" },
        "c_data_type": { "$ref": "#/$defs/dataType" },
        "compute_mode": { "$ref": "#/$defs/computeMode" },
        "a_layout": { "$ref": "#/$defs/layout" },
        "b_layout": { "$ref": "#/$defs/layout" },
        "c_layout": { "$ref": "#/$defs/layout" },
        "a_operation": { "$ref": "#/$defs/matrixOperation" },
        "b_operation": { "$ref": "#/$defs/matrixOperation" },
        "alpha": { "type": "number" },
        "beta": { "type": "number" },
        "requested_chunk_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "effective_chunk_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_cache_target_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "initial_cache_target_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_workspace_cap_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "effective_workspace_cap_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "context_mode": { "enum": ["isolated", "attach_current"] },
        "policy": { "enum": ["clock", "lru"] },
        "staging_slots": { "type": "integer", "minimum": 2, "maximum": 8 },
        "prefetch_distance": { "type": "integer", "minimum": 0, "maximum": 8 },
        "passes": { "type": "integer", "minimum": 1 },
        "budget_poll_ms": { "type": "integer", "minimum": 1 },
        "stall_timeout_ms": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_tile_ms": { "type": "integer", "minimum": 1 },
        "identifiers_included": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id", "status", "m", "n", "k", "a_data_type", "b_data_type", "c_data_type",
        "effective_compute_mode", "tile_m", "tile_n", "tile_k", "tile_count",
        "maximum_working_set_bytes", "workspace_bytes", "uses_cublas_lt",
        "heuristic_algorithm_count", "replan_count"
      ],
      "properties": {
        "plan_id": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["not_run", "planned", "completed", "failed", "replanned"] },
        "m": { "type": "integer", "minimum": 0 },
        "n": { "type": "integer", "minimum": 0 },
        "k": { "type": "integer", "minimum": 0 },
        "a_data_type": { "$ref": "#/$defs/dataType" },
        "b_data_type": { "$ref": "#/$defs/dataType" },
        "c_data_type": { "$ref": "#/$defs/dataType" },
        "effective_compute_mode": { "$ref": "#/$defs/computeMode" },
        "tile_m": { "type": "integer", "minimum": 0 },
        "tile_n": { "type": "integer", "minimum": 0 },
        "tile_k": { "type": "integer", "minimum": 0 },
        "tile_count": { "type": "integer", "minimum": 0 },
        "maximum_working_set_bytes": { "type": "integer", "minimum": 0 },
        "workspace_bytes": { "type": "integer", "minimum": 0 },
        "uses_cublas_lt": { "type": "boolean" },
        "heuristic_algorithm_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "replan_count": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      },
      "allOf": [{
        "if": {
          "properties": { "status": { "enum": ["planned", "completed", "replanned"] } },
          "required": ["status"]
        },
        "then": {
          "properties": {
            "m": { "type": "integer", "minimum": 1 },
            "n": { "type": "integer", "minimum": 1 },
            "k": { "type": "integer", "minimum": 1 },
            "tile_m": { "type": "integer", "minimum": 1 },
            "tile_n": { "type": "integer", "minimum": 1 },
            "tile_k": { "type": "integer", "minimum": 1 },
            "tile_count": { "type": "integer", "minimum": 1 },
            "maximum_working_set_bytes": { "type": "integer", "minimum": 1 }
          }
        }
      }]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "plan_id", "status", "passes_completed", "tiles_total", "tiles_retired",
        "logical_allocation_bytes", "oversubscribed", "cache_hits", "cache_misses",
        "cache_hit_rate", "bytes_h2d", "bytes_d2h", "clean_evictions", "dirty_evictions",
        "writebacks_completed", "mapping_count", "unmap_count", "set_access_count",
        "handle_reuse_count", "event_boundary_count", "unsafe_remap_count",
        "unsafe_transition_count", "elapsed_ms", "achieved_tflops", "output_digest128"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["not_run", "completed", "failed", "timed_out"] },
        "passes_completed": { "type": "integer", "minimum": 0 },
        "tiles_total": { "type": "integer", "minimum": 0 },
        "tiles_retired": { "type": "integer", "minimum": 0 },
        "logical_allocation_bytes": { "type": "integer", "minimum": 0 },
        "oversubscribed": { "type": "boolean" },
        "cache_hits": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_misses": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_hit_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "bytes_h2d": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "bytes_d2h": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "clean_evictions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "dirty_evictions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "writebacks_completed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mapping_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unmap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "set_access_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "handle_reuse_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "event_boundary_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_remap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_transition_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "achieved_tflops": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "output_digest128": { "$ref": "#/$defs/nullableDigest128" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
        "then": {
          "properties": {
            "passes_completed": { "type": "integer", "minimum": 1 },
            "tiles_total": { "type": "integer", "minimum": 1 },
            "tiles_retired": { "type": "integer", "minimum": 1 },
            "logical_allocation_bytes": { "type": "integer", "minimum": 1 },
            "cache_hits": { "type": "integer", "minimum": 0 },
            "cache_misses": { "type": "integer", "minimum": 0 },
            "cache_hit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "bytes_h2d": { "type": "integer", "minimum": 0 },
            "bytes_d2h": { "type": "integer", "minimum": 0 },
            "dirty_evictions": { "type": "integer", "minimum": 0 },
            "writebacks_completed": { "type": "integer", "minimum": 0 },
            "mapping_count": { "type": "integer", "minimum": 0 },
            "unmap_count": { "type": "integer", "minimum": 0 },
            "set_access_count": { "type": "integer", "minimum": 0 },
            "event_boundary_count": { "type": "integer", "minimum": 0 },
            "unsafe_remap_count": { "const": 0 },
            "unsafe_transition_count": { "const": 0 },
            "elapsed_ms": { "type": "number", "minimum": 0 },
            "achieved_tflops": { "type": "number", "minimum": 0 },
            "output_digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
          }
        }
      }]
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_mode", "reference_precision", "absolute_tolerance", "relative_tolerance",
        "maximum_absolute_error", "maximum_relative_error", "elements_verified",
        "mismatch_count", "first_mismatch_byte_offset", "expected_digest128",
        "output_digest128", "all_results_match"
      ],
      "properties": {
        "validation_mode": { "enum": ["none", "cpu", "structured"] },
        "reference_precision": { "enum": ["none", "fp32", "fp64", "analytic"] },
        "absolute_tolerance": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "relative_tolerance": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "maximum_absolute_error": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "maximum_relative_error": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "elements_verified": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mismatch_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "first_mismatch_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "expected_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "output_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "all_results_match": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_bytes_initial", "target_bytes_minimum", "target_bytes_maximum",
        "target_bytes_end", "resident_bytes_peak", "pinned_staging_bytes",
        "workspace_bytes_peak", "physical_frame_count_peak", "physical_handle_create_count",
        "physical_handle_release_count", "handle_reuse_count", "mapping_count", "unmap_count",
        "set_access_count", "event_boundary_count", "unsafe_remap_count",
        "unsafe_transition_count", "cache_hits", "cache_misses", "cache_hit_rate",
        "clean_evictions", "dirty_evictions", "writebacks_completed", "target_shrink_count",
        "target_grow_count", "target_oom_retry_count"
      ],
      "properties": {
        "target_bytes_initial": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_bytes_maximum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "resident_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pinned_staging_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "workspace_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "physical_frame_count_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "physical_handle_create_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "physical_handle_release_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "handle_reuse_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mapping_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unmap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "set_access_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
