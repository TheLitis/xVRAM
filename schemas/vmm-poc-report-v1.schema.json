{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheLitis/xVRAM/main/schemas/vmm-poc-report-v1.schema.json",
  "title": "xVRAM VMM proof-of-concept report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "generated_at_utc", "build", "system", "device",
    "configuration", "modes", "proof", "outcome", "cleanup", "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_type": { "const": "xvram.vmm_poc" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "build": { "$ref": "#/$defs/build" },
    "system": { "$ref": "#/$defs/system" },
    "device": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/device" }] },
    "configuration": { "$ref": "#/$defs/configuration" },
    "modes": { "$ref": "#/$defs/modes" },
    "proof": { "$ref": "#/$defs/proof" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "nullableNonNegativeNumber": { "type": ["number", "null"], "minimum": 0 },
    "nullableString": { "type": ["string", "null"] },
    "nullableBoolean": { "type": ["boolean", "null"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "nullableDigest128": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit", "compiler", "build_type", "cuda_headers_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "build_type": { "type": "string", "minLength": 1 },
        "cuda_headers_version": { "type": "integer", "minimum": 13000 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name", "os_version", "architecture", "logical_processor_count",
        "physical_memory_bytes", "available_memory_bytes"
      ],
      "properties": {
        "os_name": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string" },
        "architecture": { "type": "string", "minLength": 1 },
        "logical_processor_count": { "type": "integer", "minimum": 0 },
        "physical_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "available_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "name", "uuid", "luid", "pci_bus_id", "driver_model", "total_memory_bytes",
        "free_memory_bytes_start", "safe_device_budget_bytes", "wddm_budget_bytes_start",
        "wddm_usage_bytes_start", "wddm_available_bytes_start",
        "wddm_available_bytes_minimum", "wddm_available_bytes_end", "vmm_supported",
        "minimum_granularity_bytes", "recommended_granularity_bytes"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "uuid": { "$ref": "#/$defs/nullableString" },
        "luid": { "$ref": "#/$defs/nullableString" },
        "pci_bus_id": { "$ref": "#/$defs/nullableString" },
        "driver_model": {
          "type": ["string", "null"],
          "enum": ["wddm", "tcc", "mcdm", "unknown", null]
        },
        "total_memory_bytes": { "type": "integer", "minimum": 1 },
        "free_memory_bytes_start": { "type": "integer", "minimum": 0 },
        "safe_device_budget_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_budget_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_usage_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "vmm_supported": { "type": "boolean" },
        "minimum_granularity_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "recommended_granularity_bytes": { "$ref": "#/$defs/nullablePositiveInteger" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_device_ordinal", "requested_logical_bytes", "requested_chunk_bytes",
        "requested_window_slots", "effective_window_slots", "passes", "timeout_ms",
        "stall_timeout_ms", "seed_hex", "host_headroom_bytes", "device_headroom_bytes",
        "sizing_mode", "mode", "identifiers_included"
      ],
      "properties": {
        "requested_device_ordinal": { "type": ["integer", "null"], "minimum": 0 },
        "requested_logical_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_chunk_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "requested_window_slots": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "effective_window_slots": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "passes": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "stall_timeout_ms": { "type": "integer", "minimum": 1 },
        "seed_hex": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "host_headroom_bytes": { "type": "integer", "minimum": 0 },
        "device_headroom_bytes": { "type": "integer", "minimum": 0 },
        "sizing_mode": { "enum": ["auto", "explicit", "mixed"] },
        "mode": { "enum": ["compare", "reference", "pipeline"] },
        "identifiers_included": { "type": "boolean" }
      }
    },
    "timingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "total_ms", "minimum_ms", "median_ms", "p95_ms", "maximum_ms"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "total_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "minimum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "median_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "p95_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "maximum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" }
      },
      "allOf": [{
        "if": { "properties": { "sample_count": { "minimum": 1 } }, "required": ["sample_count"] },
        "then": { "properties": {
          "total_ms": { "type": "number", "minimum": 0 },
          "minimum_ms": { "type": "number", "minimum": 0 },
          "median_ms": { "type": "number", "minimum": 0 },
          "p95_ms": { "type": "number", "minimum": 0 },
          "maximum_ms": { "type": "number", "minimum": 0 }
        } }
      }]
    },
    "modeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "elements_processed", "tiles_processed", "passes_completed", "bytes_h2d",
        "bytes_d2h", "mapping_count", "unmap_count", "remap_count", "event_boundary_count",
        "unsafe_remap_count", "physical_handle_count", "max_concurrent_mappings", "slot_count",
        "set_access_count", "handle_reuse_count", "stable_addresses_verified",
        "full_verification_completed", "matches_cpu", "elapsed_ms", "setup_ms", "h2d_ms",
        "kernel_ms", "d2h_ms", "verification_ms", "remap_timing", "expected_digest128",
        "output_digest128", "mismatch_count", "first_mismatch_byte_offset"
      ],
      "properties": {
        "status": { "enum": ["not_run", "completed", "failed", "timed_out"] },
        "elements_processed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tiles_processed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "passes_completed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "bytes_h2d": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "bytes_d2h": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mapping_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unmap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "remap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "event_boundary_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_remap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "physical_handle_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "max_concurrent_mappings": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "slot_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "set_access_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "handle_reuse_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "stable_addresses_verified": { "$ref": "#/$defs/nullableBoolean" },
        "full_verification_completed": { "$ref": "#/$defs/nullableBoolean" },
        "matches_cpu": { "$ref": "#/$defs/nullableBoolean" },
        "elapsed_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "setup_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "h2d_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "kernel_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "d2h_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "verification_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "remap_timing": { "$ref": "#/$defs/timingSummary" },
        "expected_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "output_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "mismatch_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "first_mismatch_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
        "then": { "properties": {
          "elements_processed": { "type": "integer", "minimum": 1 },
          "tiles_processed": { "type": "integer", "minimum": 1 },
          "passes_completed": { "type": "integer", "minimum": 1 },
          "bytes_h2d": { "type": "integer", "minimum": 1 },
          "bytes_d2h": { "type": "integer", "minimum": 1 },
          "mapping_count": { "type": "integer", "minimum": 0 },
          "unmap_count": { "type": "integer", "minimum": 0 },
          "remap_count": { "type": "integer", "minimum": 0 },
          "event_boundary_count": { "type": "integer", "minimum": 0 },
          "unsafe_remap_count": { "type": "integer", "minimum": 0 },
          "physical_handle_count": { "type": "integer", "minimum": 0 },
          "max_concurrent_mappings": { "type": "integer", "minimum": 0 },
          "slot_count": { "type": "integer", "minimum": 1 },
          "set_access_count": { "type": "integer", "minimum": 0 },
          "handle_reuse_count": { "type": "integer", "minimum": 0 },
          "stable_addresses_verified": { "const": true },
          "full_verification_completed": { "const": true },
          "matches_cpu": { "const": true },
          "elapsed_ms": { "type": "number", "minimum": 0 },
          "setup_ms": { "type": "number", "minimum": 0 },
          "h2d_ms": { "type": "number", "minimum": 0 },
          "kernel_ms": { "type": "number", "minimum": 0 },
          "d2h_ms": { "type": "number", "minimum": 0 },
          "verification_ms": { "type": "number", "minimum": 0 },
          "expected_digest128": { "$ref": "#/$defs/digest128" },
          "output_digest128": { "$ref": "#/$defs/digest128" },
          "mismatch_count": { "const": 0 },
          "first_mismatch_byte_offset": { "const": null }
        } }
      }]
    },
    "completedModeResult": {
      "allOf": [
        { "$ref": "#/$defs/modeResult" },
        { "properties": { "status": { "const": "completed" } } }
      ]
    },
    "completedReferenceModeResult": {
      "allOf": [
        { "$ref": "#/$defs/completedModeResult" },
        { "properties": {
          "mapping_count": { "type": "integer", "minimum": 2 },
          "unmap_count": { "type": "integer", "minimum": 2 },
          "remap_count": { "type": "integer", "minimum": 1 },
          "event_boundary_count": { "type": "integer", "minimum": 2 },
          "unsafe_remap_count": { "const": 0 },
          "physical_handle_count": { "const": 1 },
          "max_concurrent_mappings": { "const": 1 },
          "slot_count": { "const": 1 },
          "set_access_count": { "type": "integer", "minimum": 2 },
          "handle_reuse_count": { "type": "integer", "minimum": 1 },
          "remap_timing": {
            "allOf": [
              { "$ref": "#/$defs/timingSummary" },
              { "properties": { "sample_count": { "type": "integer", "minimum": 1 } } }
            ]
          }
        } }
      ]
    },
    "completedPipelineModeResult": {
      "allOf": [
        { "$ref": "#/$defs/completedModeResult" },
        { "properties": {
          "mapping_count": { "type": "integer", "minimum": 2 },
          "unmap_count": { "type": "integer", "minimum": 2 },
          "remap_count": { "type": "integer", "minimum": 1 },
          "event_boundary_count": { "type": "integer", "minimum": 2 },
          "unsafe_remap_count": { "const": 0 },
          "physical_handle_count": { "type": "integer", "minimum": 2, "maximum": 8 },
          "max_concurrent_mappings": { "type": "integer", "minimum": 2, "maximum": 8 },
          "slot_count": { "type": "integer", "minimum": 2, "maximum": 8 },
          "set_access_count": { "type": "integer", "minimum": 2 },
          "handle_reuse_count": { "type": "integer", "minimum": 1 },
          "remap_timing": {
            "allOf": [
              { "$ref": "#/$defs/timingSummary" },
              { "properties": { "sample_count": { "type": "integer", "minimum": 1 } } }
            ]
          }
        } }
      ]
    },
    "notRunModeResult": {
      "allOf": [
        { "$ref": "#/$defs/modeResult" },
        { "properties": {
          "status": { "const": "not_run" },
          "elements_processed": { "const": null },
          "tiles_processed": { "const": null },
          "passes_completed": { "const": null },
          "bytes_h2d": { "const": null },
          "bytes_d2h": { "const": null },
          "mapping_count": { "const": null },
          "unmap_count": { "const": null },
          "remap_count": { "const": null },
          "event_boundary_count": { "const": null },
          "unsafe_remap_count": { "const": null },
          "physical_handle_count": { "const": null },
          "max_concurrent_mappings": { "const": null },
          "slot_count": { "const": null },
          "set_access_count": { "const": null },
          "handle_reuse_count": { "const": null },
          "stable_addresses_verified": { "const": null },
          "full_verification_completed": { "const": null },
          "matches_cpu": { "const": null },
          "elapsed_ms": { "const": null },
          "setup_ms": { "const": null },
          "h2d_ms": { "const": null },
          "kernel_ms": { "const": null },
          "d2h_ms": { "const": null },
          "verification_ms": { "const": null },
          "remap_timing": {
            "properties": {
              "sample_count": { "const": 0 },
              "total_ms": { "const": null },
              "minimum_ms": { "const": null },
              "median_ms": { "const": null },
              "p95_ms": { "const": null },
              "maximum_ms": { "const": null }
            }
          },
          "expected_digest128": { "const": null },
          "output_digest128": { "const": null },
          "mismatch_count": { "const": null },
          "first_mismatch_byte_offset": { "const": null }
        } }
      ]
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backing", "traversal", "verification", "timeout_enforcement", "reference", "pipeline",
        "pipeline_speedup"
      ],
      "properties": {
        "backing": { "const": "pageable_host" },
        "traversal": { "const": "alternating_sequential" },
        "verification": { "const": "full_uint32_cpu_reference" },
        "timeout_enforcement": { "const": "isolated_worker" },
        "reference": { "$ref": "#/$defs/modeResult" },
        "pipeline": { "$ref": "#/$defs/modeResult" },
        "pipeline_speedup": { "$ref": "#/$defs/nullableNonNegativeNumber" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_logical_bytes", "effective_chunk_bytes", "logical_element_count",
        "logical_chunk_count", "tile_visit_count", "address_revisit_count",
        "resident_physical_bytes", "pinned_staging_bytes", "kernel_module_version",
        "kernel_module_sha256", "pattern_version", "cpu_reference_digest128",
        "handles_reused", "physical_window_smaller", "stable_virtual_addresses_verified",
        "event_boundaries_verified", "reference_matches_cpu", "pipeline_matches_cpu", "modes_match"
      ],
      "properties": {
        "effective_logical_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "effective_chunk_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "logical_element_count": { "$ref": "#/$defs/nullablePositiveInteger" },
        "logical_chunk_count": { "$ref": "#/$defs/nullablePositiveInteger" },
        "tile_visit_count": { "$ref": "#/$defs/nullablePositiveInteger" },
        "address_revisit_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "resident_physical_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "pinned_staging_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "kernel_module_version": { "type": "integer", "minimum": 0 },
        "kernel_module_sha256": { "type": "string" },
        "pattern_version": { "type": "string" },
        "cpu_reference_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "handles_reused": { "$ref": "#/$defs/nullableBoolean" },
        "physical_window_smaller": { "$ref": "#/$defs/nullableBoolean" },
        "stable_virtual_addresses_verified": { "$ref": "#/$defs/nullableBoolean" },
        "event_boundaries_verified": { "$ref": "#/$defs/nullableBoolean" },
        "reference_matches_cpu": { "$ref": "#/$defs/nullableBoolean" },
        "pipeline_matches_cpu": { "$ref": "#/$defs/nullableBoolean" },
        "modes_match": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "exit_code", "stage", "operation", "native_code", "native_name",
        "message", "mode", "pass_index", "tile_index", "logical_byte_offset"
      ],
      "properties": {
        "status": { "enum": ["completed", "skipped", "failed"] },
        "reason": {
          "type": ["string", "null"],
          "enum": [
            "device_unavailable", "vmm_unsupported", "invalid_configuration",
            "insufficient_host_memory", "insufficient_device_budget", "host_oom", "device_oom",
            "timeout", "data_mismatch", "cuda_error", "platform_error", "cleanup_error",
            "internal_error", null
          ]
        },
        "exit_code": { "type": "integer", "minimum": 0 },
        "stage": {
          "type": ["string", "null"],
          "enum": [
            "planning", "reserve", "host_backing", "physical_allocation", "mapping",
            "transfer_h2d", "kernel", "transfer_d2h", "verification", "unmapping", "cleanup",
            "watchdog", null
          ]
        },
        "operation": { "$ref": "#/$defs/nullableString" },
        "native_code": { "$ref": "#/$defs/nullableInteger" },
        "native_name": { "$ref": "#/$defs/nullableString" },
        "message": { "$ref": "#/$defs/nullableString" },
        "mode": { "type": ["string", "null"], "enum": ["reference", "pipeline", null] },
        "pass_index": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "tile_index": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete", "events_drained", "events_destroyed", "streams_destroyed", "module_unloaded",
        "device_allocations_released", "mappings_removed", "physical_handle_released",
        "virtual_reservation_released", "pinned_staging_released", "host_backing_released",
        "context_destroyed", "worker_terminated"
      ],
      "properties": {
        "complete": { "$ref": "#/$defs/nullableBoolean" },
        "events_drained": { "$ref": "#/$defs/nullableBoolean" },
        "events_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "streams_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "module_unloaded": { "$ref": "#/$defs/nullableBoolean" },
        "device_allocations_released": { "$ref": "#/$defs/nullableBoolean" },
        "mappings_removed": { "$ref": "#/$defs/nullableBoolean" },
        "physical_handle_released": { "$ref": "#/$defs/nullableBoolean" },
        "virtual_reservation_released": { "$ref": "#/$defs/nullableBoolean" },
        "pinned_staging_released": { "$ref": "#/$defs/nullableBoolean" },
        "host_backing_released": { "$ref": "#/$defs/nullableBoolean" },
        "context_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "worker_terminated": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "component", "operation", "message", "code", "device_ordinal"],
      "properties": {
        "level": { "enum": ["info", "warning", "error"] },
        "component": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "code": { "$ref": "#/$defs/nullableInteger" },
        "device_ordinal": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": { "properties": { "status": { "const": "completed" } }, "required": ["status"] }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "device": {
            "allOf": [
              { "$ref": "#/$defs/device" },
              { "properties": {
                "vmm_supported": { "const": true },
                "minimum_granularity_bytes": { "type": "integer", "minimum": 1 }
              } }
            ]
          },
          "configuration": { "properties": {
            "passes": { "type": "integer", "minimum": 2 },
            "effective_window_slots": { "type": "integer", "minimum": 1, "maximum": 8 }
          } },
          "proof": { "properties": {
            "effective_logical_bytes": { "type": "integer", "minimum": 1 },
            "effective_chunk_bytes": { "type": "integer", "minimum": 1 },
            "logical_element_count": { "type": "integer", "minimum": 1 },
            "logical_chunk_count": { "type": "integer", "minimum": 1 },
            "tile_visit_count": { "type": "integer", "minimum": 2 },
            "address_revisit_count": { "type": "integer", "minimum": 1 },
            "resident_physical_bytes": { "type": "integer", "minimum": 1 },
            "pinned_staging_bytes": { "type": "integer", "minimum": 1 },
            "kernel_module_version": { "type": "integer", "minimum": 1 },
            "kernel_module_sha256": { "$ref": "#/$defs/sha256" },
            "pattern_version": { "type": "string", "minLength": 1 },
            "cpu_reference_digest128": { "$ref": "#/$defs/digest128" },
            "handles_reused": { "const": true },
            "physical_window_smaller": { "const": true },
            "stable_virtual_addresses_verified": { "const": true },
            "event_boundaries_verified": { "const": true }
          } },
          "outcome": { "properties": { "reason": { "const": null }, "exit_code": { "const": 0 } } },
          "cleanup": { "properties": {
            "complete": { "const": true },
            "events_drained": { "const": true },
            "events_destroyed": { "const": true },
            "streams_destroyed": { "const": true },
            "module_unloaded": { "const": true },
            "device_allocations_released": { "const": true },
            "mappings_removed": { "const": true },
            "physical_handle_released": { "const": true },
            "virtual_reservation_released": { "const": true },
            "pinned_staging_released": { "const": true },
            "host_backing_released": { "const": true },
            "context_destroyed": { "const": true },
            "worker_terminated": { "const": true }
          } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "configuration": {
            "properties": { "mode": { "const": "compare" } },
            "required": ["mode"]
          }
        },
        "required": ["outcome", "configuration"]
      },
      "then": { "properties": {
        "configuration": { "properties": {
          "effective_window_slots": { "type": "integer", "minimum": 2, "maximum": 8 }
        } },
        "modes": { "properties": {
          "reference": { "$ref": "#/$defs/completedReferenceModeResult" },
          "pipeline": { "$ref": "#/$defs/completedPipelineModeResult" },
          "pipeline_speedup": { "type": "number", "exclusiveMinimum": 0 }
        } },
        "proof": { "properties": {
          "reference_matches_cpu": { "const": true },
          "pipeline_matches_cpu": { "const": true },
          "modes_match": { "const": true }
        } }
      } }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "configuration": {
            "properties": { "mode": { "const": "reference" } },
            "required": ["mode"]
          }
        },
        "required": ["outcome", "configuration"]
      },
      "then": { "properties": {
        "configuration": { "properties": {
          "effective_window_slots": { "const": 1 }
        } },
        "modes": { "properties": {
          "reference": { "$ref": "#/$defs/completedReferenceModeResult" },
          "pipeline": { "$ref": "#/$defs/notRunModeResult" },
          "pipeline_speedup": { "const": null }
        } },
        "proof": { "properties": {
          "reference_matches_cpu": { "const": true },
          "pipeline_matches_cpu": { "const": null },
          "modes_match": { "const": null }
        } }
      } }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "configuration": {
            "properties": { "mode": { "const": "pipeline" } },
            "required": ["mode"]
          }
        },
        "required": ["outcome", "configuration"]
      },
      "then": { "properties": {
        "configuration": { "properties": {
          "effective_window_slots": { "type": "integer", "minimum": 2, "maximum": 8 }
        } },
        "modes": { "properties": {
          "reference": { "$ref": "#/$defs/notRunModeResult" },
          "pipeline": { "$ref": "#/$defs/completedPipelineModeResult" },
          "pipeline_speedup": { "const": null }
        } },
        "proof": { "properties": {
          "reference_matches_cpu": { "const": null },
          "pipeline_matches_cpu": { "const": true },
          "modes_match": { "const": null }
        } }
      } }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "enum": ["skipped", "failed"] } },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": { "properties": { "outcome": { "properties": {
        "reason": { "type": "string" },
        "exit_code": { "type": "integer", "minimum": 1 }
      } } } }
    },
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": { "identifiers_included": { "const": false } },
            "required": ["identifiers_included"]
          }
        },
        "required": ["configuration"]
      },
      "then": { "properties": { "device": { "oneOf": [
        { "type": "null" },
        { "allOf": [
          { "$ref": "#/$defs/device" },
          { "properties": {
            "uuid": { "const": null },
            "luid": { "const": null },
            "pci_bus_id": { "const": null }
          } }
        ] }
      ] } } }
    }
  ]
}
