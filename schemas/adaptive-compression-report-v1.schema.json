{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xvram.dev/schemas/adaptive-compression-report-v1.schema.json",
  "title": "xVRAM adaptive lossless compression report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "generated_at_utc", "build", "system", "device",
    "configuration", "workloads", "backing", "codec", "telemetry", "proof", "outcome",
    "cleanup", "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_type": { "const": "xvram.adaptive_compression" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "build": { "$ref": "#/$defs/build" },
    "system": { "$ref": "#/$defs/system" },
    "device": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/device" }] },
    "configuration": { "$ref": "#/$defs/configuration" },
    "workloads": { "type": "array", "items": { "$ref": "#/$defs/workload" } },
    "backing": { "$ref": "#/$defs/backing" },
    "codec": { "$ref": "#/$defs/codec" },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "proof": { "$ref": "#/$defs/proof" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "nullableBoolean": { "type": ["boolean", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "nullableNonNegativeNumber": { "type": ["number", "null"], "minimum": 0 },
    "nullableRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "nullableString": { "type": ["string", "null"] },
    "nullableDigest128": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{32}$"
    },
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit", "compiler", "build_type", "cuda_headers_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "build_type": { "type": "string", "minLength": 1 },
        "cuda_headers_version": { "type": "integer", "minimum": 0 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name", "os_version", "architecture", "logical_processor_count",
        "physical_memory_bytes", "available_memory_bytes"
      ],
      "properties": {
        "os_name": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string" },
        "architecture": { "type": "string", "minLength": 1 },
        "logical_processor_count": { "type": "integer", "minimum": 0 },
        "physical_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "available_memory_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "name", "uuid", "luid", "pci_bus_id", "driver_model",
        "total_memory_bytes", "free_memory_bytes_start", "free_memory_bytes_end",
        "safe_device_budget_bytes", "wddm_budget_bytes_start", "wddm_usage_bytes_start",
        "wddm_available_bytes_minimum", "compute_capability_major",
        "compute_capability_minor", "vmm_supported", "uva_supported"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "uuid": { "$ref": "#/$defs/nullableString" },
        "luid": { "$ref": "#/$defs/nullableString" },
        "pci_bus_id": { "$ref": "#/$defs/nullableString" },
        "driver_model": { "$ref": "#/$defs/nullableString" },
        "total_memory_bytes": { "type": "integer", "minimum": 0 },
        "free_memory_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "free_memory_bytes_end": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "safe_device_budget_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_budget_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_usage_bytes_start": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "wddm_available_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compute_capability_major": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compute_capability_minor": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "vmm_supported": { "type": "boolean" },
        "uva_supported": { "type": "boolean" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_device_ordinal", "requested_logical_bytes", "effective_logical_bytes",
        "requested_chunk_bytes", "effective_chunk_bytes", "requested_cache_target_bytes",
        "initial_cache_target_bytes", "compression_policy", "path", "codec",
        "replacement_policy", "scenario", "passes", "warmup_passes",
        "measurement_passes", "host_store_cap_bytes", "host_headroom_bytes",
        "device_headroom_bytes", "compression_scratch_cap_bytes", "codec_slots",
        "codec_workers", "staging_slots", "prefetch_distance", "budget_poll_ms",
        "stall_timeout_ms", "timeout_ms", "seed_hex", "sizing_mode", "trace_enabled",
        "identifiers_included"
      ],
      "properties": {
        "requested_device_ordinal": { "type": ["integer", "null"], "minimum": 0 },
        "requested_logical_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "effective_logical_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "requested_chunk_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "effective_chunk_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "requested_cache_target_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "initial_cache_target_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compression_policy": { "enum": ["adaptive", "capacity", "both"] },
        "path": {
          "enum": ["auto", "raw", "cpu_lz4_gpu_decode", "nvcomp_gpu_codec", "all"]
        },
        "codec": { "enum": ["auto", "lz4"] },
        "replacement_policy": { "enum": ["clock", "lru", "both"] },
        "scenario": {
          "enum": [
            "suite", "compressible-read", "incompressible-read", "reuse",
            "dirty-writeback", "mixed", "budget-pressure"
          ]
        },
        "passes": { "type": "integer", "minimum": 1 },
        "warmup_passes": { "type": "integer", "minimum": 0 },
        "measurement_passes": { "type": "integer", "minimum": 1 },
        "host_store_cap_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "host_headroom_bytes": { "type": "integer", "minimum": 0 },
        "device_headroom_bytes": { "type": "integer", "minimum": 0 },
        "compression_scratch_cap_bytes": { "type": "integer", "minimum": 0 },
        "codec_slots": { "type": "integer", "minimum": 2, "maximum": 8 },
        "codec_workers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "staging_slots": { "type": "integer", "minimum": 2, "maximum": 8 },
        "prefetch_distance": { "type": "integer", "minimum": 0, "maximum": 8 },
        "budget_poll_ms": { "type": "integer", "minimum": 1 },
        "stall_timeout_ms": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "seed_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{16}$" },
        "sizing_mode": { "enum": ["auto", "explicit"] },
        "trace_enabled": { "type": "boolean" },
        "identifiers_included": { "type": "boolean" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "compression_policy", "path", "replacement_policy", "status",
        "logical_bytes", "logical_chunk_count", "operations_retired",
        "warmup_passes_completed", "measurement_passes_completed", "raw_input_bytes",
        "stored_bytes", "stored_ratio", "logical_h2d_bytes", "pcie_h2d_bytes",
        "logical_d2h_bytes", "pcie_d2h_bytes", "raw_path_decisions",
        "cpu_lz4_gpu_decisions", "gpu_lz4_decisions", "never_compress_decisions",
        "fallback_count", "mappings", "set_access", "unmaps", "events_recorded",
        "events_retired", "unsafe_remaps", "unsafe_transitions", "elapsed_ms",
        "expected_digest128", "output_digest128", "mismatch_count",
        "first_mismatch_byte_offset"
      ],
      "properties": {
        "scenario": {
          "enum": [
            "compressible-read", "incompressible-read", "reuse", "dirty-writeback",
            "mixed", "budget-pressure"
          ]
        },
        "compression_policy": { "enum": ["adaptive", "capacity"] },
        "path": { "enum": ["raw", "cpu_lz4_gpu_decode", "nvcomp_gpu_codec"] },
        "replacement_policy": { "enum": ["clock", "lru"] },
        "status": { "enum": ["not_run", "completed", "failed", "timed_out"] },
        "logical_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_chunk_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "operations_retired": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "warmup_passes_completed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "measurement_passes_completed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_input_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "stored_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "stored_ratio": { "$ref": "#/$defs/nullableRatio" },
        "logical_h2d_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pcie_h2d_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_d2h_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pcie_d2h_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_path_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cpu_lz4_gpu_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "gpu_lz4_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "never_compress_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "fallback_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mappings": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "set_access": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unmaps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "events_recorded": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "events_retired": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_remaps": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_transitions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "expected_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "output_digest128": { "$ref": "#/$defs/nullableDigest128" },
        "mismatch_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "first_mismatch_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
        "then": { "properties": {
          "logical_bytes": { "type": "integer", "minimum": 1 },
          "logical_chunk_count": { "type": "integer", "minimum": 1 },
          "operations_retired": { "type": "integer", "minimum": 1 },
          "raw_input_bytes": { "type": "integer", "minimum": 1 },
          "stored_bytes": { "type": "integer", "minimum": 0 },
          "stored_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "mappings": { "type": "integer", "minimum": 0 },
          "set_access": { "type": "integer", "minimum": 0 },
          "unmaps": { "type": "integer", "minimum": 0 },
          "events_recorded": { "type": "integer", "minimum": 0 },
          "events_retired": { "type": "integer", "minimum": 0 },
          "unsafe_remaps": { "const": 0 },
          "unsafe_transitions": { "const": 0 },
          "elapsed_ms": { "type": "number", "minimum": 0 },
          "expected_digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "output_digest128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "mismatch_count": { "const": 0 }
        } }
      }]
    },
    "backing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_bytes", "host_store_cap_bytes", "host_bytes_current", "host_bytes_peak",
        "raw_bytes_current", "raw_bytes_peak", "compressed_bytes_current",
        "compressed_bytes_peak", "spill_reserved_bytes_peak", "conversion_scratch_bytes_peak",
        "invalid_chunks", "implicit_zero_chunks", "raw_chunks", "lz4_chunks",
        "generations_created", "generations_committed", "generations_discarded",
        "atomic_commit_failures", "expansion_rejections", "effective_stored_ratio"
      ],
      "properties": {
        "logical_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "host_store_cap_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "host_bytes_current": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "host_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_bytes_current": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compressed_bytes_current": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "compressed_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "spill_reserved_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "conversion_scratch_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "invalid_chunks": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "implicit_zero_chunks": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_chunks": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "lz4_chunks": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "generations_created": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "generations_committed": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "generations_discarded": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "atomic_commit_failures": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "expansion_rejections": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "effective_stored_ratio": { "$ref": "#/$defs/nullableRatio" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "total_ms", "minimum_ms", "median_ms", "p95_ms", "maximum_ms"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "total_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "minimum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "median_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "p95_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "maximum_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" }
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_version", "block_bytes", "cpu_codec", "cpu_codec_version",
        "nvcomp_available", "nvcomp_version", "nvcomp_library_source",
        "nvcomp_library_sha256", "cpu_encode_operations", "cpu_decode_operations",
        "gpu_encode_operations", "gpu_decode_operations", "raw_path_decisions",
        "cpu_lz4_gpu_decisions", "gpu_lz4_decisions", "never_compress_decisions",
        "calibration_samples", "fallback_count", "verification_failures", "codec_slots_peak",
        "workspace_bytes_peak", "cpu_encode_timing", "cpu_decode_timing",
        "gpu_encode_timing", "gpu_decode_timing"
      ],
      "properties": {
        "container_version": { "const": "xvram_lz4_blocks_v1" },
        "block_bytes": { "const": 65536 },
        "cpu_codec": { "const": "lz4" },
        "cpu_codec_version": { "$ref": "#/$defs/nullableString" },
        "nvcomp_available": { "$ref": "#/$defs/nullableBoolean" },
        "nvcomp_version": { "$ref": "#/$defs/nullableString" },
        "nvcomp_library_source": {
          "type": ["string", "null"],
          "enum": ["app_local", "explicit", null]
        },
        "nvcomp_library_sha256": { "$ref": "#/$defs/nullableSha256" },
        "cpu_encode_operations": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cpu_decode_operations": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "gpu_encode_operations": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "gpu_decode_operations": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "raw_path_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cpu_lz4_gpu_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "gpu_lz4_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "never_compress_decisions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "calibration_samples": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "fallback_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "verification_failures": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "codec_slots_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "workspace_bytes_peak": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cpu_encode_timing": { "$ref": "#/$defs/timing" },
        "cpu_decode_timing": { "$ref": "#/$defs/timing" },
        "gpu_encode_timing": { "$ref": "#/$defs/timing" },
        "gpu_decode_timing": { "$ref": "#/$defs/timing" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_elapsed_ms", "logical_h2d_bytes", "pcie_h2d_bytes", "logical_d2h_bytes",
        "pcie_d2h_bytes", "mapping_count", "set_access_count", "unmap_count",
        "event_record_count", "event_retire_count", "handle_reuse_count",
        "unsafe_remap_count", "unsafe_transition_count", "writeback_count",
        "target_shrink_count", "target_grow_count", "budget_sample_count",
        "cache_target_bytes_minimum", "cache_target_bytes_maximum", "trace_records_emitted",
        "trace_records_dropped", "trace_complete", "raw_transfer_timing",
        "compressed_transfer_timing", "writeback_timing"
      ],
      "properties": {
        "total_elapsed_ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "logical_h2d_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pcie_h2d_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_d2h_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "pcie_d2h_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "mapping_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "set_access_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unmap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "event_record_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "event_retire_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "handle_reuse_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_remap_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "unsafe_transition_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "writeback_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_shrink_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "target_grow_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "budget_sample_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_target_bytes_minimum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "cache_target_bytes_maximum": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "trace_records_emitted": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "trace_records_dropped": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "trace_complete": { "$ref": "#/$defs/nullableBoolean" },
        "raw_transfer_timing": { "$ref": "#/$defs/timing" },
        "compressed_transfer_timing": { "$ref": "#/$defs/timing" },
        "writeback_timing": { "$ref": "#/$defs/timing" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_data_exceeds_vram", "cache_smaller_than_logical",
        "authoritative_compressed_backing_verified", "no_expansion_stored",
        "generation_atomicity_verified", "write_admission_verified",
        "gpu_encode_before_d2h_verified", "compressed_h2d_reduction_verified",
        "stable_virtual_addresses_verified", "maps_match_set_access",
        "event_boundaries_verified", "host_budget_respected", "device_budget_respected",
        "all_workloads_match_reference", "path_digests_match", "policy_digests_match",
        "raw_virtual_addresses_omitted"
      ],
      "properties": {
        "logical_data_exceeds_vram": { "$ref": "#/$defs/nullableBoolean" },
        "cache_smaller_than_logical": { "$ref": "#/$defs/nullableBoolean" },
        "authoritative_compressed_backing_verified": { "$ref": "#/$defs/nullableBoolean" },
        "no_expansion_stored": { "$ref": "#/$defs/nullableBoolean" },
        "generation_atomicity_verified": { "$ref": "#/$defs/nullableBoolean" },
        "write_admission_verified": { "$ref": "#/$defs/nullableBoolean" },
        "gpu_encode_before_d2h_verified": { "$ref": "#/$defs/nullableBoolean" },
        "compressed_h2d_reduction_verified": { "$ref": "#/$defs/nullableBoolean" },
        "stable_virtual_addresses_verified": { "$ref": "#/$defs/nullableBoolean" },
        "maps_match_set_access": { "$ref": "#/$defs/nullableBoolean" },
        "event_boundaries_verified": { "$ref": "#/$defs/nullableBoolean" },
        "host_budget_respected": { "$ref": "#/$defs/nullableBoolean" },
        "device_budget_respected": { "$ref": "#/$defs/nullableBoolean" },
        "all_workloads_match_reference": { "$ref": "#/$defs/nullableBoolean" },
        "path_digests_match": { "$ref": "#/$defs/nullableBoolean" },
        "policy_digests_match": { "$ref": "#/$defs/nullableBoolean" },
        "raw_virtual_addresses_omitted": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "exit_code", "stage", "operation", "native_code",
        "native_name", "message", "scenario", "allocation_id", "chunk_index",
        "generation", "logical_byte_offset"
      ],
      "properties": {
        "status": { "enum": ["completed", "skipped", "corruption", "oom", "timeout", "failed"] },
        "reason": { "$ref": "#/$defs/nullableString" },
        "exit_code": { "enum": [0, 23, 24, 25, 26, 27, 64, 70, 74] },
        "stage": { "$ref": "#/$defs/nullableString" },
        "operation": { "$ref": "#/$defs/nullableString" },
        "native_code": { "$ref": "#/$defs/nullableInteger" },
        "native_name": { "$ref": "#/$defs/nullableString" },
        "message": { "$ref": "#/$defs/nullableString" },
        "scenario": { "$ref": "#/$defs/nullableString" },
        "allocation_id": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "chunk_index": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "generation": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "logical_byte_offset": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      },
      "allOf": [{
        "if": {
          "properties": { "status": { "enum": ["skipped", "corruption", "oom", "timeout", "failed"] } },
          "required": ["status"]
        },
        "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
      }]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete", "operations_drained", "codec_slots_drained", "events_drained",
        "events_destroyed", "streams_destroyed", "mappings_removed",
        "physical_handles_released", "codec_workspace_released",
        "virtual_reservations_released", "pinned_staging_released",
        "spill_reservations_released", "host_backing_released", "context_released",
        "trace_closed", "worker_terminated"
      ],
      "properties": {
        "complete": { "$ref": "#/$defs/nullableBoolean" },
        "operations_drained": { "$ref": "#/$defs/nullableBoolean" },
        "codec_slots_drained": { "$ref": "#/$defs/nullableBoolean" },
        "events_drained": { "$ref": "#/$defs/nullableBoolean" },
        "events_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "streams_destroyed": { "$ref": "#/$defs/nullableBoolean" },
        "mappings_removed": { "$ref": "#/$defs/nullableBoolean" },
        "physical_handles_released": { "$ref": "#/$defs/nullableBoolean" },
        "codec_workspace_released": { "$ref": "#/$defs/nullableBoolean" },
        "virtual_reservations_released": { "$ref": "#/$defs/nullableBoolean" },
        "pinned_staging_released": { "$ref": "#/$defs/nullableBoolean" },
        "spill_reservations_released": { "$ref": "#/$defs/nullableBoolean" },
        "host_backing_released": { "$ref": "#/$defs/nullableBoolean" },
        "context_released": { "$ref": "#/$defs/nullableBoolean" },
        "trace_closed": { "$ref": "#/$defs/nullableBoolean" },
        "worker_terminated": { "$ref": "#/$defs/nullableBoolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "component", "operation", "message", "code", "device_ordinal"],
      "properties": {
        "level": { "enum": ["info", "warning", "error"] },
        "component": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/nullableInteger" },
        "device_ordinal": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "allOf": [{
    "if": {
      "properties": { "outcome": { "properties": { "status": { "const": "completed" } } } },
      "required": ["outcome"]
    },
    "then": {
      "properties": {
        "device": { "$ref": "#/$defs/device" },
        "workloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/workload" },
              { "properties": { "status": { "const": "completed" } } }
            ]
          }
        },
        "proof": { "properties": {
          "logical_data_exceeds_vram": { "const": true },
          "cache_smaller_than_logical": { "const": true },
          "generation_atomicity_verified": { "const": true },
          "stable_virtual_addresses_verified": { "const": true },
          "maps_match_set_access": { "const": true },
          "event_boundaries_verified": { "const": true },
          "host_budget_respected": { "const": true },
          "device_budget_respected": { "const": true },
          "all_workloads_match_reference": { "const": true },
          "raw_virtual_addresses_omitted": { "const": true }
        } },
        "cleanup": { "properties": {
          "complete": { "const": true },
          "operations_drained": { "const": true },
          "codec_slots_drained": { "const": true },
          "events_drained": { "const": true },
          "events_destroyed": { "const": true },
          "streams_destroyed": { "const": true },
          "mappings_removed": { "const": true },
          "physical_handles_released": { "const": true },
          "codec_workspace_released": { "const": true },
          "virtual_reservations_released": { "const": true },
          "pinned_staging_released": { "const": true },
          "spill_reservations_released": { "const": true },
          "host_backing_released": { "const": true },
          "context_released": { "const": true },
          "trace_closed": { "const": true },
          "worker_terminated": { "const": true }
        } },
        "telemetry": { "properties": {
          "unsafe_remap_count": { "const": 0 },
          "unsafe_transition_count": { "const": 0 }
        } }
      }
    }
  }]
}
